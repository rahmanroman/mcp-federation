{
  "name": "mcp-federation",
  "version": "1.0.0",
  "description": "Local MCP gateway federating multiple HTTP MCP servers behind one endpoint",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx bin/mcp-federation.ts",
    "start": "node dist/bin/mcp-federation.js start",
    "probe": "tsx scripts/probe.ts",
    "mock": "tsx test/mock-downstream.ts",
    "test": "tsx test/e2e.ts",
    "prepare": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmanroman/mcp-federation.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rahmanroman/mcp-federation/issues"
  },
  "homepage": "https://github.com/rahmanroman/mcp-federation#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "node-notifier": "10.0.1",
    "open": "11.0.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/node-notifier": "8.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module",
  "bin": {
    "mcp-federation": "dist/bin/mcp-federation.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
